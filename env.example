# Use 127.0.0.1 instead of "localhost": on Windows, "localhost" can add 1-2 seconds to every request.
BIONIC_BASE_URL=http://127.0.0.1:1235/v1
BIONIC_MODEL=qwen3.5-4b
BIONIC_API_KEY=

# Speed options (all optional)
# Ask Qwen-style models to skip their long "thinking" step. Turn off with 0 if your server rejects it.
BIONIC_NO_THINK=1
# If replies are still slow because the model keeps thinking, set this to 1 to also append /no_think to each message.
BIONIC_NO_THINK_TAG=0
# Load the model when CampusAI starts so the first chat is not slow. Set 0 to disable.
BIONIC_WARMUP=1

# Max tokens for a chat reply. Thinking models need room to think AND answer; raise this if replies are cut off.
BIONIC_CHAT_MAX_TOKENS=1500
# The AI settings window (⚙ in the app) can also change the API URL, model and key. Those are saved in the database
# and override this file. Changing them is only allowed from the computer running CampusAI, unless you set:
# ALLOW_REMOTE_SETTINGS=1
